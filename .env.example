# Copied to .env by `pnpm run setup`, which also fills in a real secret.

# Postgres from docker-compose.yml.
DATABASE_URL=postgres://binary:binary@localhost:5433/binary
# A separate database so tests never touch your dev data.
TEST_DATABASE_URL=postgres://binary:binary@localhost:5433/binary_test

# Signs sessions. The API refuses to start while this is a placeholder.
# Make one with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-a-random-secret

# Master key that encrypts everyone's AI provider keys (AES-256-GCM).
# 32 random bytes, base64. The API refuses to start without a valid one.
# Make one with: openssl rand -base64 32
# Keep it safe: if it changes, saved provider keys can't be read anymore.
ENCRYPTION_KEY=replace-with-32-random-bytes-base64

# Where the API runs, and the web app that is allowed to call it.
BETTER_AUTH_URL=http://localhost:3001
WEB_URL=http://localhost:3000

# Optional: Composio connects Gmail, GitHub, Slack and hundreds more apps.
# Get a key at https://platform.composio.dev. Leave empty to turn it off.
COMPOSIO_API_KEY=
